# Template only: this file and .env are not automatically loaded by settings.py.
# Inject these variables into the process environment or configure a separate loader.
# NOT RUNNABLE AS-IS: replace every placeholder with a private value before use.
# Generate a unique secret; never use this example value for real sessions.
SECRET_KEY=replace-with-a-unique-private-secret
DEBUG=false
# Set explicit hostnames for production; do not use a wildcard.
ALLOWED_HOSTS=localhost

# First-release target: MySQL. These values are examples, NOT usable credentials.
DB_BACKEND=mysql
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Local, non-connecting configuration checks only (existing SQLite path):
# DB_BACKEND=sqlite
